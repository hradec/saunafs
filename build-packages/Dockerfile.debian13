# Use the official Debian 12 (bookworm) base image
FROM debian:13 AS build

# Install all system packages required to build SaunaFS.  The
# INSTALL.md document in the SaunaFS repository lists a fairly large
# collection of build dependencies needed when producing deb packages on
# Ubuntu.  Most of these packages are also available on Debian 12 and
# provide the libraries and tools (e.g. boost, fuse3, fmt, spdlog, etc.)
# that SaunaFS links against【179789461533997†L91-L103】.  We also
# include a few extra utilities such as git and wget for fetching
# sources and tidy/time for documentation.
RUN apt-get update && apt-get install -y --no-install-recommends \
    acl asciidoc attr bc build-essential ca-certificates-java ccache cmake curl \
    debhelper devscripts fuse3 git libblkid-dev libboost-filesystem-dev \
    libboost-iostreams-dev libboost-program-options-dev libboost-system-dev \
    libcrcutil-dev libdb-dev libfmt-dev libfuse3-dev libgoogle-perftools-dev \
    libgtest-dev libisal-dev libjudy-dev libpam0g-dev libspdlog-dev \
    libsystemd-dev liburcu-dev libyaml-cpp-dev lsb-release netcat-openbsd \
    nfs4-acl-tools pkg-config pylint python3 python3-pip rsync socat sudo \
    tidy time uuid-dev valgrind wget zlib1g-dev \
    curl zip unzip tar rsync google-mock libgmock-dev \
    && rm -rf /var/lib/apt/lists/*


RUN apt-get update ; apt-get install -y prometheus prometheus-cpp-dev ruby
RUN apt install -y asciidoctor

# Set a sensible default command.  Users can override this on the
# command line if they want to run specific SaunaFS components.
CMD ["bash"]
